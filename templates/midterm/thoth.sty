% --- Lệnh Header cho mã đề thi giữa kỳ (hỗ trợ \Header{mã_đề} hoặc \Header{mã_đề}{số_câu}) ---
\makeatletter
\newcommand{\Header}[1]{%
  \@ifnextchar\bgroup{\Header@two{#1}}{\Header@one{#1}}%
}
\newcommand{\Header@one}[1]{\Header@two{#1}{15}}
\newcommand{\Header@two}[2]{%
\vspace{0.2cm}
\begin{center}
    \setlength{\fboxsep}{3pt}%
    \fbox{\textbf{Mã đề thi: #1}} \textbf{(Đề gồm #2 câu)}
\end{center}
\vspace{-0.15cm}
\noindent\textbf{Chú ý:} \textit{Sinh viên không sử dụng tài liệu khi làm bài thi.}\par
\vspace{2pt}
\noindent\rule{\textwidth}{0.4pt}\par
\vspace{3pt}
}
\makeatother

